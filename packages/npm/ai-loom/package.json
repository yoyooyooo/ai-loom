{
  "name": "ai-loom",
  "version": "0.0.23",
  "description": "AI Loom CLI (bundles web UI) with platform-specific server binaries via optionalDependencies",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "bin": {
    "ai-loom": "dist/cli.js"
  },
  "files": [
    "dist",
    "web"
  ],
  "optionalDependencies": {
    "@ai-loom/server-darwin-arm64": "0.0.23",
    "@ai-loom/server-darwin-x64": "0.0.23",
    "@ai-loom/server-linux-arm64-gnu": "0.0.23",
    "@ai-loom/server-linux-arm64-musl": "0.0.23",
    "@ai-loom/server-linux-x64-gnu": "0.0.23",
    "@ai-loom/server-linux-x64-musl": "0.0.23",
    "@ai-loom/server-win32-x64-msvc": "0.0.23"
  },
  "dependencies": {
    "detect-libc": "^2.0.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "tsup": "^8.1.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "tsup": {
    "entry": [
      "src/cli.ts"
    ],
    "format": [
      "cjs"
    ],
    "target": "node18",
    "sourcemap": true,
    "minify": false,
    "clean": true
  },
  "publishConfig": {
    "access": "public"
  }
}
